    "# SAVE the background-removed cache to /kaggle/working (kept with the notebook output): lossless zlib chunks, compressed in parallel.\n",
    "# Worst case (incompressible) is ~14 GiB, so it fits in 19.5 GiB; flat grey backgrounds compress well, so expect much less.\n",
    "import os, shutil, zlib, glob, time, json\n",
    "import numpy as np\n",
    "from concurrent.futures import ThreadPoolExecutor\n",
    "SAVE = \"/kaggle/working/nobg_saved\"; os.makedirs(SAVE, exist_ok=True); CS = 1000\n",
    "def save_chunks(name, path):\n",
    "    a = np.load(path, mmap_mode=\"r\")\n",
    "    def job(k): open(f\"{SAVE}/{name}_{k//CS:04d}.z\", \"wb\").write(zlib.compress(np.ascontiguousarray(a[k:k+CS]).tobytes(), 3))\n",
    "    with ThreadPoolExecutor(4) as ex: list(ex.map(job, range(0, len(a), CS)))\n",
    "    return [list(a.shape), a.dtype.str]\n",
    "t = time.time()\n",
    "meta = {n: save_chunks(n, f\"{NOBG}/{f}\") for n, f in [(\"imgs\", \"imgs_224_nobg.npy\"), (\"alpha\", \"alpha_224.npy\")]}\n",
    "for f in [\"ids_224_nobg.npy\", \"ok_224_nobg.npy\"]: shutil.copy(f\"{NOBG}/{f}\", SAVE)\n",
    "json.dump({**meta, \"cs\": CS}, open(f\"{SAVE}/meta.json\", \"w\"))\n",
    "print(f\"saved {sum(os.path.getsize(p) for p in glob.glob(SAVE + '/*'))/2**30:.1f} GiB in {time.time()-t:.0f}s | /kaggle/working free: {shutil.disk_usage('/kaggle/working').free/2**30:.1f} GiB\")"
