    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import os\n",
    "os.environ.setdefault(\"HF_HUB_DISABLE_PROGRESS_BARS\", \"1\")   # hundreds of progress lines can stall a notebook output stream\n",
    "import argparse, copy, json, math, os, queue, random, threading, time\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import torch, torch.nn as nn, torch.nn.functional as F\n",
    "import torch.distributed as dist\n",
    "from sklearn.metrics import roc_auc_score\n",
    "import labels as L\n",
    "\n",
    "# ------------------------------------------------------------------ utils\n",
    "RANK = int(os.environ.get(\"RANK\", 0))\n",
    "def log(*a):\n",
    "    if RANK == 0:\n",
    "        print(time.strftime(\"%H:%M:%S\"), *a, flush=True)\n",
    "\n",
    "def init_dist():\n",
    "    if int(os.environ.get(\"WORLD_SIZE\", 1)) > 1:\n",
    "        dist.init_process_group(\"nccl\")\n",
    "        local = int(os.environ.get(\"LOCAL_RANK\", 0))\n",
    "        torch.cuda.set_device(local)\n",
    "        return dist.get_rank(), dist.get_world_size(), torch.device(\"cuda\", local)\n",
    "    return 0, 1, torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "def macro_auc(y, p):\n",
    "    per = []\n",
    "    for c in range(y.shape[1]):\n",
    "        per.append(roc_auc_score(y[:, c], p[:, c]) if 0 < y[:, c].sum() < len(y) else float(\"nan\"))\n",
    "    return float(np.nanmean(per)), per\n",
    "\n",
    "# ------------------------------------------------------------------ data\n",
    "class Loader:\n",
    "    \"\"\"uint8 memmap -> pinned CPU batches (background thread). Yields (x_uint8[B,H,W,3], y[B,K], idx[B]).\"\"\"\n",
    "    def __init__(self, mm, Y, rows, bs, rank, world, train, seed, dev, depth=4):\n",
    "        self.mm, self.Y, self.rows, self.bs, self.dev = mm, Y, np.asarray(rows), bs, dev\n",
    "        self.rank, self.world, self.train, self.seed, self.depth = rank, world, train, seed, depth\n",
    "        self.epoch = 0\n",
    "    def set_epoch(self, e): self.epoch = e\n",
    "    def _order(self):\n",
    "        o = self.rows\n",
    "        if self.train:\n",
    "            o = o[np.random.default_rng(self.seed + self.epoch).permutation(len(o))]\n",
    "            o = o[: (len(o) // (self.bs * self.world)) * self.bs * self.world]   # equal #batches on every rank\n",
    "        return o[self.rank::self.world]\n",
    "    def __len__(self):\n",
    "        n = len(self._order())\n",
    "        return n // self.bs if self.train else math.ceil(n / self.bs)\n",
    "    def __iter__(self):\n",
    "        order = self._order()\n",
    "        chunks = [order[i:i + self.bs] for i in range(0, len(order), self.bs)]\n",
    "        if self.train and chunks and len(chunks[-1]) < self.bs: chunks.pop()\n",
    "        q: queue.Queue = queue.Queue(self.depth)\n",
    "        # CUDA's current device is per-THREAD; resolve an index here (main thread) because set_device rejects a bare \"cuda\"\n",
    "        cuda_idx = (self.dev.index if self.dev.index is not None else torch.cuda.current_device()) if self.dev.type == \"cuda\" else None\n",
    "        def produce():\n",
    "            try:\n",
    "                if cuda_idx is not None: torch.cuda.set_device(cuda_idx)\n",
    "                for ch in chunks:\n",
    "                    idx = np.sort(ch)\n",
    "                    x = torch.from_numpy(np.ascontiguousarray(self.mm[idx]))\n",
    "                    if self.dev.type == \"cuda\": x = x.pin_memory()\n",
    "                    q.put((x, torch.from_numpy(self.Y[idx]), idx))\n",
    "                q.put(None)\n",
    "            except Exception as e:                       # surface worker errors in the main thread\n",
    "                q.put(e)\n",
    "        threading.Thread(target=produce, daemon=True).start()\n",
    "        while True:\n",
    "            item = q.get()\n",
    "            if item is None: return\n",
    "            if isinstance(item, Exception): raise item\n",
    "            yield item\n",
    "\n",
    "def to_float(x_u8, dev):\n",
    "    \"\"\"uint8 NHWC (pinned) -> float NCHW in [0,1]; the permute makes it channels_last for free.\"\"\"\n",
    "    return x_u8.to(dev, non_blocking=True).permute(0, 3, 1, 2).float().div_(255.0)\n",
    "\n",
    "def gpu_augment(x, a):\n",
    "    B, dev = x.shape[0], x.device\n",
    "    u = lambda lo, hi: torch.empty(B, device=dev).uniform_(lo, hi)\n",
    "    ang = u(-a.rot, a.rot) * math.pi / 180\n",
    "    s = u(a.zoom_min, 1.0)                                         # <1 = zoom in\n",
    "    flip = (torch.rand(B, device=dev) < 0.5).float() * 2 - 1       # -1 = horizontal flip\n",
    "    th = torch.zeros(B, 2, 3, device=dev)\n",
    "    th[:, 0, 0] = s * torch.cos(ang) * flip; th[:, 0, 1] = -s * torch.sin(ang)\n",
    "    th[:, 1, 0] = s * torch.sin(ang) * flip; th[:, 1, 1] = s * torch.cos(ang)\n",
    "    th[:, 0, 2] = u(-a.shift, a.shift); th[:, 1, 2] = u(-a.shift, a.shift)\n",
    "    x = F.grid_sample(x, F.affine_grid(th, list(x.shape), align_corners=False),\n",
    "                      mode=\"bilinear\", padding_mode=\"reflection\", align_corners=False)\n",
    "    m = x.mean((1, 2, 3), keepdim=True)                            # contrast / brightness\n",
    "    x = ((x - m) * u(0.8, 1.2).view(B, 1, 1, 1) + m + u(-0.1, 0.1).view(B, 1, 1, 1))\n",
    "    if a.gray_p > 0:                                               # random grayscale (reduces colour/era shortcuts)\n",
    "        g = (x * x.new_tensor([0.299, 0.587, 0.114]).view(1, 3, 1, 1)).sum(1, keepdim=True).expand_as(x)\n",
    "        k = (torch.rand(B, 1, 1, 1, device=dev) < a.gray_p).float()\n",
    "        x = k * g + (1 - k) * x\n",
    "    if a.erase_p > 0:                                              # one random rectangle per selected sample\n",
    "        H, W = x.shape[2:]\n",
    "        area = u(0.02, 0.12) * H * W; ar = torch.exp(u(math.log(0.5), math.log(2.0)))\n",
    "        h = (area * ar).sqrt().clamp(max=H - 1).view(B, 1, 1); w = (area / ar).sqrt().clamp(max=W - 1).view(B, 1, 1)\n",
    "        y0 = torch.rand(B, 1, 1, device=dev) * (H - h); x0 = torch.rand(B, 1, 1, device=dev) * (W - w)\n",
    "        yy = torch.arange(H, device=dev).view(1, H, 1); xx = torch.arange(W, device=dev).view(1, 1, W)\n",
    "        box = ((yy >= y0) & (yy < y0 + h) & (xx >= x0) & (xx < x0 + w)).unsqueeze(1)\n",
    "        box &= (torch.rand(B, 1, 1, 1, device=dev) < a.erase_p)\n",
    "        x = torch.where(box, torch.rand_like(x), x)\n",
    "    return x.clamp_(0, 1)\n",
    "\n",
    "# ------------------------------------------------------------------ model\n",
    "class Net(nn.Module):\n",
    "    def __init__(self, name, n_out, drop, drop_path, img_size, prior, pretrained=True):\n",
    "        super().__init__()\n",
    "        import timm\n",
    "        kw = {}\n",
    "        if drop_path > 0: kw[\"drop_path_rate\"] = drop_path\n",
    "        if img_size != 224 and any(k in name for k in (\"vit\", \"deit\", \"eva\", \"beit\")): kw[\"img_size\"] = img_size\n",
    "        self.backbone = timm.create_model(name, pretrained=pretrained, num_classes=0, **kw)\n",
    "        cfg = timm.data.resolve_data_config({}, model=self.backbone)\n",
    "        self.register_buffer(\"mean\", torch.tensor(cfg[\"mean\"]).view(1, 3, 1, 1), persistent=False)\n",
    "        self.register_buffer(\"std\", torch.tensor(cfg[\"std\"]).view(1, 3, 1, 1), persistent=False)\n",
    "        with torch.no_grad():                                      # measure the true output dim (timm's num_features can differ, e.g. MobileNetV3)\n",
    "            was = self.backbone.training; self.backbone.eval()\n",
    "            nf = int(self.backbone(torch.zeros(1, 3, img_size, img_size)).shape[-1]); self.backbone.train(was)\n",
    "        self.head = nn.Sequential(nn.Dropout(drop), nn.Linear(nf, n_out))\n",
    "        with torch.no_grad():                                      # start at the label prior -> stable early epochs\n",
    "            self.head[1].weight.mul_(0.1)\n",
    "            self.head[1].bias.copy_(torch.logit(torch.as_tensor(prior, dtype=torch.float32).clamp(1e-3, 1 - 1e-3)))\n",
    "    def forward(self, x):                                          # x: float [0,1], NCHW\n",
    "        return self.head(self.backbone((x - self.mean) / self.std))\n",
    "\n",
    "def param_groups(net, lr, head_mult, wd, lld):\n",
    "    \"\"\"Layer-wise LR decay on the backbone via timm (falls back to flat LR if the model has no layer map).\"\"\"\n",
    "    groups, used = [], \"flat\"\n",
    "    try:\n",
    "        from timm.optim import param_groups_layer_decay\n",
    "        for g in param_groups_layer_decay(net.backbone, weight_decay=wd, layer_decay=lld):\n",
    "            g[\"base_lr\"] = lr * g.pop(\"lr_scale\", 1.0); groups.append(g)\n",
    "        used = f\"layer-decay {lld}\"\n",
    "    except Exception as e:\n",
    "        log(\"  [layer-decay unavailable -> flat LR]\", type(e).__name__, str(e)[:80])\n",
    "        dec = [p for n, p in net.backbone.named_parameters() if p.ndim > 1]\n",
    "        nod = [p for n, p in net.backbone.named_parameters() if p.ndim <= 1]\n",
    "        groups = [dict(params=dec, weight_decay=wd, base_lr=lr), dict(params=nod, weight_decay=0.0, base_lr=lr)]\n",
    "    hd = [p for p in net.head.parameters() if p.ndim > 1]; hn = [p for p in net.head.parameters() if p.ndim <= 1]\n",
    "    groups += [dict(params=hd, weight_decay=wd, base_lr=lr * head_mult), dict(params=hn, weight_decay=0.0, base_lr=lr * head_mult)]\n",
    "    for g in groups: g[\"lr\"] = g[\"base_lr\"]\n",
    "    return groups, used\n",
    "\n",
    "class EMA:\n",
    "    def __init__(self, net, decay):\n",
    "        self.module, self.decay = copy.deepcopy(net).eval(), decay\n",
    "        for p in self.module.parameters(): p.requires_grad_(False)\n",
    "        e, m = list(self.module.state_dict().values()), list(net.state_dict().values())   # state_dict tensors alias the live params/buffers\n",
    "        fl = [x.dtype.is_floating_point for x in e]\n",
    "        self.fe = [x for x, f in zip(e, fl) if f]; self.fm = [y for y, f in zip(m, fl) if f]\n",
    "        self.ie = [x for x, f in zip(e, fl) if not f]; self.im = [y for y, f in zip(m, fl) if not f]\n",
    "    @torch.no_grad()\n",
    "    def update(self, step):\n",
    "        d = min(self.decay, (1 + step) / (10 + step))\n",
    "        torch._foreach_mul_(self.fe, d); torch._foreach_add_(self.fe, self.fm, alpha=1 - d)\n",
    "        for x, y in zip(self.ie, self.im): x.copy_(y)\n",
    "\n",
    "# ------------------------------------------------------------------ losses\n",
    "def make_loss(name, eps, gamma):\n",
    "    def bce(lg, y):\n",
    "        return F.binary_cross_entropy_with_logits(lg, y * (1 - eps) + 0.5 * eps)\n",
    "    def focal(lg, y):\n",
    "        t = y * (1 - eps) + 0.5 * eps\n",
    "        ce = F.binary_cross_entropy_with_logits(lg, t, reduction=\"none\"); p = torch.sigmoid(lg)\n",
    "        return (ce * (1 - (p * t + (1 - p) * (1 - t))).pow(gamma)).mean()\n",
    "    def asl(lg, y, g_neg=4.0, clip=0.05):                          # Asymmetric loss (Ridnik et al.)\n",
    "        p = torch.sigmoid(lg); pm = (p - clip).clamp(min=0)\n",
    "        return -(y * torch.log(p.clamp(min=1e-8)) + (1 - y) * pm.pow(g_neg) * torch.log((1 - pm).clamp(min=1e-8))).mean()\n",
    "    return {\"bce\": bce, \"focal\": focal, \"asl\": asl}[name]\n",
    "\n",
    "def lr_scale(step, total, warm, floor=0.02):\n",
    "    if step < warm: return (step + 1) / warm\n",
    "    t = (step - warm) / max(1, total - warm)\n",
    "    return floor + (1 - floor) * 0.5 * (1 + math.cos(math.pi * t))\n",
    "\n",
    "# ------------------------------------------------------------------ eval\n",
    "@torch.no_grad()\n",
    "def predict(model, loader, dev, world, tta):\n",
    "    \"\"\"returns (idx, p_plain, p_tta); p_tta is None unless tta. One forward (+1 flipped forward) per batch.\"\"\"\n",
    "    model.eval(); idxs, o0, o1 = [], [], []\n",
    "    for xb, _, idx in loader:\n",
    "        x = to_float(xb, dev)\n",
    "        with torch.autocast(\"cuda\", dtype=torch.float16, enabled=dev.type == \"cuda\"):\n",
    "            lg = model(x).float()\n",
    "            if tta: lg1 = (lg + model(x.flip(3).contiguous(memory_format=torch.channels_last)).float()) / 2\n",
    "        o0.append(torch.sigmoid(lg).cpu().numpy()); idxs.append(idx)\n",
    "        if tta: o1.append(torch.sigmoid(lg1).cpu().numpy())\n",
    "    local = (np.concatenate(idxs), np.concatenate(o0), np.concatenate(o1) if tta else None)\n",
    "    if world > 1:\n",
    "        g = [None] * world; dist.all_gather_object(g, local)\n",
    "        local = (np.concatenate([a for a, _, _ in g]), np.concatenate([b for _, b, _ in g]),\n",
    "                 np.concatenate([c for _, _, c in g]) if tta else None)\n",
    "    o = np.argsort(local[0])\n",
    "    return local[0][o], local[1][o], (local[2][o] if tta else None)\n",
    "\n",
    "# ------------------------------------------------------------------ main\n",
    "def main():\n",
    "    ap = argparse.ArgumentParser()\n",
    "    ap.add_argument(\"--base_dir\", required=True); ap.add_argument(\"--labels\", default=None)\n",
    "    ap.add_argument(\"--cache_dir\", default=\"./cache\", help=\"outputs: split, checkpoints, predictions (and the image cache unless --img_cache_dir)\")\n",
    "    ap.add_argument(\"--img_cache_dir\", default=None, help=\"read-only image cache, e.g. an attached Kaggle dataset\"); ap.add_argument(\"--cache_tag\", default=\"224\")\n",
    "    ap.add_argument(\"--scheme\", default=\"v2\", choices=list(L.SCHEMES))\n",
    "    ap.add_argument(\"--backbone\", default=\"convnext_tiny.fb_in22k_ft_in1k\"); ap.add_argument(\"--run\", default=None)\n",
    "    ap.add_argument(\"--epochs\", type=int, default=5); ap.add_argument(\"--batch_size\", type=int, default=64, help=\"per GPU\")\n",
    "    ap.add_argument(\"--lr\", type=float, default=1e-4, help=\"LR of the top backbone layer\"); ap.add_argument(\"--head_mult\", type=float, default=5.0)\n",
    "    ap.add_argument(\"--layer_decay\", type=float, default=0.8); ap.add_argument(\"--wd\", type=float, default=0.05)\n",
    "    ap.add_argument(\"--warmup_epochs\", type=float, default=1.0)\n",
    "    ap.add_argument(\"--drop\", type=float, default=0.3); ap.add_argument(\"--drop_path\", type=float, default=0.1)\n",
    "    ap.add_argument(\"--loss\", default=\"bce\", choices=[\"bce\", \"focal\", \"asl\"]); ap.add_argument(\"--smoothing\", type=float, default=0.05)\n",
    "    ap.add_argument(\"--focal_gamma\", type=float, default=2.0)\n",
    "    ap.add_argument(\"--ema_decay\", type=float, default=0.998, help=\"0 disables EMA\")\n",
    "    ap.add_argument(\"--mixup\", type=float, default=0.0, help=\"Beta(a,a); 0 = off\")\n",
    "    ap.add_argument(\"--rot\", type=float, default=8.0); ap.add_argument(\"--zoom_min\", type=float, default=0.85)\n",
    "    ap.add_argument(\"--shift\", type=float, default=0.05); ap.add_argument(\"--gray_p\", type=float, default=0.1)\n",
    "    ap.add_argument(\"--erase_p\", type=float, default=0.25)\n",
    "    ap.add_argument(\"--img_size\", type=int, default=224); ap.add_argument(\"--patience\", type=int, default=2, help=\"0 = off\")\n",
    "    ap.add_argument(\"--subset\", type=int, default=0, help=\"smoke test: use only N train rows (val/test N//5)\")\n",
    "    ap.add_argument(\"--seed\", type=int, default=42)\n",
    "    ap.add_argument(\"--find_unused\", action=\"store_true\", help=\"DDP find_unused_parameters (only if DDP complains)\")\n",
    "    a = ap.parse_args()\n",
    "    run = a.run or a.backbone.split(\".\")[0]\n",
    "\n",
    "    rank, world, dev = init_dist()\n",
    "    torch.manual_seed(a.seed); np.random.seed(a.seed); random.seed(a.seed)\n",
    "    torch.backends.cudnn.benchmark = True\n",
    "    out = Path(a.cache_dir); out.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    # ---- labels / rows / split (identical on every rank, no communication needed)\n",
    "    df = L.load_labels(a.labels or os.path.join(a.base_dir, \"labels_utf8.csv\"))\n",
    "    Y, nch, nrec, _ = L.build(df, a.scheme)\n",
