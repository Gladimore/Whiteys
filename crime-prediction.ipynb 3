    "%%writefile labels.py\n",
    "\"\"\"\n",
    "labels.py -- offense parsing + category schemes (no torch needed).\n",
    "\n",
    "The 'Sex Offender' column is never loaded (usecols excludes it) and nothing is derived from it.\n",
    "\n",
    "Schemes\n",
    "  v1 : the original 9 categories, regexes bug-fixed (comma split, a few coverage holes).\n",
    "  v2 : 7 cleaned targets.  Changes vs v1 (see README cell for why):\n",
    "         * Kidnapping merged into Robbery  -> Robbery_Kidnap   (Kidnapping was 2.8% of inmates, 36x self-lift)\n",
    "         * Weapon_Offenses = weapon possession/use charges only; \"armed robbery / agg battery w/ firearm /\n",
    "           armed home invasion\" no longer double-count as Weapon (was inflating Weapon to 34% + 0.70 P(Weapon|Robbery))\n",
    "         * Traffic_Other dropped as a *target* (grab-bag: DUI, escape, obstruction, contraband, registration\n",
    "           violations); it is still recognised so that inmates with only such charges count as valid negatives.\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import argparse, re\n",
    "from collections import Counter\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# Sex-offender-registry style CHARGES (e.g. \"VIOLATE SEX OFFENDER REGIS\", \"FAILURE TO REPORT ANNUALLY/2+\",\n",
    "# \"CHILD SEX OFFENDER/SCHOOL ZONE\") are treated as Sexual_Offenses labels.  These are charge strings in the Offense\n",
    "# column; the separate 'Sex Offender' flag column is still never loaded.  Set False to route them to 'Other'.\n",
    "SEXREG_AS_SEXUAL = True\n",
    "_SEXREG = re.compile(r\"SEX OFFENDER|FAILURE TO REPORT ANNUALLY\", re.I)\n",
    "\n",
    "# --- charge splitting ------------------------------------------------------------------------\n",
    "# Offense strings are comma separated, but charge names contain thousands separators (\"15,000 GRAMS\").\n",
    "# Split only on commas that are NOT followed by exactly three digits (a thousands group).\n",
    "_SPLIT = re.compile(r\",\\s*(?!\\d{3}(?:\\D|$))\")\n",
    "_JUNK = re.compile(r\"^(?:\\d+|NOT AVAILABLE|N/?A|)$\", re.I)\n",
    "\n",
    "def parse_offenses(series: pd.Series) -> list[list[str]]:\n",
    "    out = []\n",
    "    for raw in series:\n",
    "        if pd.isna(raw):\n",
    "            out.append([]); continue\n",
    "        ch = [c.strip() for c in _SPLIT.split(str(raw))]\n",
    "        out.append([c for c in ch if not _JUNK.match(c)])\n",
    "    return out\n",
    "\n",
    "def _c(p: str) -> re.Pattern:\n",
    "    return re.compile(p, re.I)\n",
    "\n",
    "# --- v1 (original patterns + fixes marked FIX) ----------------------------------------------\n",
    "V1_NAMES = [\"Homicide\", \"Sexual_Offenses\", \"Kidnapping\", \"Robbery\", \"Assault_Battery\",\n",
    "            \"Weapon_Offenses\", \"Drug_Offenses\", \"Property_Crimes\", \"Traffic_Other\"]\n",
    "V1_PATS = [_c(p) for p in [\n",
    "    r\"MURDER|MANSLAUGHTER|KILL(?!ER)|HOMICID|VOL MAN\\b\",                                    # FIX: VOL MAN\n",
    "    r\"RAPE|INDECENT|DEVIATE|PREDATORY|PROSTIT|AGG CRIM SEX|CRIM SEX AB|CRIM SX AB|CRIM SEX ASLT\"\n",
    "    r\"|CRIM SEX ASSAULT|PRED CRIM SEX|CRIMINAL SEX|SEXUAL ASSAULT|SEXUAL ABUSE|CHILD PORN\"\n",
    "    r\"|CHILD EXPLOIT|SEXUALLY DANGEROUS|IND LIB\",                                           # FIX: last two\n",
    "    r\"KIDNAP|UNLAWFUL RESTRAINT|ABDUCTION|LURING\",\n",
    "    r\"ROBBERY|VEHICULAR HIJACK|VEH HIJACK|VEHICLE HIJACK|UNLAWFUL VEHICULAR INVASION\",                      # FIX: VEH HIJACK\n",
    "    r\"BATTERY|BTRY|ASSAULT|STALK|INTIMID|BODILY HARM|DOMESTIC|HOME INVASION|MOB ACTION|THREATEN\",\n",
    "    r\"WEAPON|WEAP\\b|FIREARM|ARMED|ARM VIOL|UUW|DISCH FIR|FOID|POSS FIR|DEFACED SER|HANDGUN|RIFLE\",\n",
    "    r\"DRUG|NARCOTIC|NARC|SCHED\\s+(?:I|II|III|IV)|SCHEDULE|AMT CON SUB|COCAINE|HEROIN|METH\\b|METHAMPH\"\n",
    "    r\"|CANNABIS|MFG/DEL|MANU|LOOK.ALIKE|CONT\\.? SUBS|CONTROLLED SUB|POSS.*CONT\\b|ANHYDROUS AMMONIA\"\n",
    "    r\"|DELIVERY|CON SUB|DEL SUB|POSS MANU CHEM|\\bCAN\\b|ECSTASY|\\bMFG\\b|^POSSESS \\d\",           # FIX: CONT. SUBS, DEL SUB, CAN, CHEM, truncated \"POSSESS 15\"\n",
    "    r\"THEFT|BURGLARY|FORGERY|FRAUD|STOLEN|ARSON|TRESPASS|CRIM TRES|CRIM DMG|CRIM DAMAGE|KNOWINGLY DMG\"\n",
    "    r\"|KNOW DAMAGE|BAD CHE?C?K|CREDIT CARD|DEBIT CARD|FORGED CR|COUNTERFEIT|PROPERTY DAMAGE|FALSE REPORT\",\n",
    "    r\"DUI|REVOKED|SUSPENDED|DRIVING|FLEE|FLEEING|ELUDE|OBSTRUCT|RESIST|ESCAPE|ESC OF FELON|FURLOUGH\"\n",
    "    r\"|PENAL INST|BAIL BOND|VIO.*ORDER|ORDER.*PROTECT|FAIL.*REG|FAIL.*REPORT|FAIL.*ADDR|FAIL.*RESID\"\n",
    "    r\"|HARASS|HARRASS|PERJURY|DISORDERLY|SEX OFFENDER|ACCIDENT|HATE CRIME\",\n",
    "]]\n",
    "assert len(V1_NAMES) == len(V1_PATS)\n",
    "\n",
    "# --- v2 -------------------------------------------------------------------------------------\n",
    "V2_TARGETS = [\"Homicide\", \"Sexual_Offenses\", \"Robbery_Kidnap\", \"Assault_Battery\",\n",
    "              \"Weapon_Possession_Use\", \"Drug_Offenses\", \"Property_Crimes\"]\n",
    "_WEAPON_INCLUDE = _c(r\"WEAPON|WEAP\\b|FIREARM|UUW|DISCH FIR|FOID|POSS FIR|DEFACED SER|HANDGUN|RIFLE|ARMED HABITUAL|ARM VIOL\")\n",
    "# charges where the weapon is only an aggravator of another crime -> not a standalone weapon offense\n",
    "_WEAPON_EXCLUDE = _c(r\"ROBBERY|BATTERY|BTRY|KIDNAP|INVASION|SEX|MURDER|ASSAULT|ASLT|HIJACK|RESTRAINT\")\n",
    "_ASSAULT_V2 = _c(V1_PATS[4].pattern + r\"|ASLT\")\n",
    "_ASSAULT_EXCLUDE = _c(r\"SEX|RAPE|DEVIATE|PREDATORY\")     # sexual assault is a Sexual label, not also Assault\n",
    "V2_PATS = [_c(p) for p in [\n",
    "    V1_PATS[0].pattern,\n",
    "    V1_PATS[1].pattern,\n",
    "    V1_PATS[3].pattern + \"|\" + V1_PATS[2].pattern,\n",
    "    \"<assault>\",                     # placeholder, handled in assign()\n",
    "    \"<weapon>\",                      # placeholder, handled in assign()\n",
    "    V1_PATS[6].pattern,\n",
    "    V1_PATS[7].pattern,\n",
    "]]\n",
    "# recognised-but-not-predicted bucket (keeps all-\"other\" inmates as valid all-negative rows)\n",
    "V2_OTHER = _c(V1_PATS[8].pattern + r\"|CONTRA\")\n",
    "\n",
    "SCHEMES = {\"v1\": (V1_NAMES, V1_PATS), \"v2\": (V2_TARGETS, V2_PATS)}\n",
    "\n",
    "def assign(charge: str, scheme: str) -> list[int]:\n",
    "    names, pats = SCHEMES[scheme]\n",
    "    if SEXREG_AS_SEXUAL and _SEXREG.search(charge):\n",
    "        return [1]                                   # index 1 = Sexual_Offenses in both schemes\n",
    "    hits = []\n",
    "    for i, p in enumerate(pats):\n",
    "        if scheme == \"v2\" and names[i] == \"Assault_Battery\":\n",
    "            if _ASSAULT_V2.search(charge) and not _ASSAULT_EXCLUDE.search(charge):\n",
    "                hits.append(i)\n",
    "        elif scheme == \"v2\" and names[i] == \"Weapon_Possession_Use\":\n",
    "            if _WEAPON_INCLUDE.search(charge) and not _WEAPON_EXCLUDE.search(charge):\n",
    "                hits.append(i)\n",
    "        elif p.search(charge):\n",
    "            hits.append(i)\n",
    "    if scheme == \"v1\" and \"CONTRA PENAL\" in charge.upper():          # FIX: contraband != drug offense\n",
    "        hits = [h for h in hits if h != 6]\n",
    "        if 8 not in hits: hits.append(8)\n",
    "    return hits\n",
    "\n",
    "def recognised(charge: str, scheme: str) -> bool:\n",
    "    \"\"\"True if the charge maps to any target OR (v2) to the non-target 'other' bucket.\"\"\"\n",
    "    if assign(charge, scheme):\n",
    "        return True\n",
    "    return scheme == \"v2\" and bool(V2_OTHER.search(charge))\n",
    "\n",
    "# --- data loading ---------------------------------------------------------------------------\n",
    "def load_labels(csv_path: str) -> pd.DataFrame:\n",
    "    \"\"\"Loads ID + visible-attribute metadata + Offense. The sex-offender column is NOT read.\"\"\"\n",
    "    df = pd.read_csv(csv_path, encoding=\"utf-8-sig\",\n",
    "                     usecols=lambda c: c.strip().lower() != \"sex offender\", dtype=str)\n",
    "    df.columns = [c.strip() for c in df.columns]\n",
    "    return df\n",
    "\n",
    "def build(df: pd.DataFrame, scheme: str):\n",
    "    \"\"\"returns Y (N,K) float32, n_charges (N,), n_recognised (N,)\"\"\"\n",
    "    names, _ = SCHEMES[scheme]\n",
    "    charges = parse_offenses(df[\"Offense\"])\n",
    "    cache: dict[str, tuple[list[int], bool]] = {}\n",
    "    Y = np.zeros((len(df), len(names)), np.float32)\n",
    "    nrec = np.zeros(len(df), np.int32)\n",
    "    for i, cs in enumerate(charges):\n",
    "        for c in cs:\n",
    "            if c not in cache:\n",
    "                cache[c] = (assign(c, scheme), recognised(c, scheme))\n",
    "            hits, rec = cache[c]\n",
    "            for h in hits: Y[i, h] = 1.0\n",
    "            nrec[i] += rec\n",
    "    return Y, np.array([len(c) for c in charges]), nrec, charges\n",
    "\n",
    "def usable_rows(Y, n_charges, n_rec):\n",
    "    \"\"\"Keep inmates that have >=1 recognised charge (so an all-zero row is a real negative, not an unmapped crime).\"\"\"\n",
    "    return (n_charges > 0) & (n_rec > 0)\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    ap = argparse.ArgumentParser()\n",
    "    ap.add_argument(\"--csv\", required=True)\n",
    "    ap.add_argument(\"--scheme\", default=\"v2\", choices=list(SCHEMES))\n",
    "    a = ap.parse_args()\n",
    "    df = load_labels(a.csv)\n",
    "    names, _ = SCHEMES[a.scheme]\n",
    "    Y, nch, nrec, charges = build(df, a.scheme)\n",
    "    keep = usable_rows(Y, nch, nrec)\n",
    "    allc = Counter(c for cs in charges for c in cs)\n",
    "    unc = Counter({c: n for c, n in allc.items() if not recognised(c, a.scheme)})\n",
    "    print(f\"rows={len(df)}  usable={keep.sum()}  charges={sum(allc.values())}  unique={len(allc)}\")\n",
    "    print(f\"unrecognised charge instances: {sum(unc.values())} ({100*sum(unc.values())/sum(allc.values()):.2f}%)\")\n",
    "    print(\"top unrecognised:\", unc.most_common(15))\n",
    "    print(\"\\ninmate-level prevalence:\")\n",
    "    for k, n in enumerate(names):\n",
    "        print(f\"  {k} {n:22s} {int(Y[keep,k].sum()):6d}  {Y[keep,k].mean():.3f}\")\n",
    "    print(\"\\nP(col | row):\")\n",
    "    C = Y[keep].T @ Y[keep]\n",
    "    print(pd.DataFrame(C / np.diag(C)[:, None], index=names, columns=[n[:7] for n in names]).round(2).to_string())\n",
    "\n",
    "\n",
    "def make_split(Y: np.ndarray, rows: np.ndarray, seed: int = 42, val_frac: float = 0.1, test_frac: float = 0.1):\n",
    "    \"\"\"80/10/10 split over `rows`, stratified on each inmate's RAREST positive label (the original\n",
    "    stratified on 'has any label', which is ~constant).  Returns train_idx, val_idx, test_idx (row ids).\"\"\"\n",
    "    from sklearn.model_selection import train_test_split\n",
    "    prev = Y[rows].mean(0)\n",
    "    key = np.full(len(rows), -1)\n",
    "    for j, r in enumerate(rows):\n",
    "        pos = np.flatnonzero(Y[r])\n",
    "        if len(pos): key[j] = pos[np.argmin(prev[pos])]\n",
    "    tr, rest = train_test_split(rows, test_size=val_frac + test_frac, stratify=key, random_state=seed)\n",
    "    key_rest = key[np.searchsorted(rows, rest)] if np.all(np.diff(rows) > 0) else None\n",
    "    va, te = train_test_split(rest, test_size=test_frac / (val_frac + test_frac), stratify=key_rest, random_state=seed)\n",
    "    return np.sort(tr), np.sort(va), np.sort(te)"
   ]
