    "%%writefile report.py\n",
    "\"\"\"\n",
    "report.py -- per-category test AUC (+95% bootstrap CI), ensembling, and a CONFOUND CHECK.  CPU only.\n",
    "\n",
    "  python report.py --csv labels_utf8.csv --cache_dir cache --runs cache/preds_*.npz\n",
    "\n",
    "Why the confound check: sex, race, hair/eye colour, apparent age/weight and the photo era are all visible in a\n",
    "mugshot AND correlate with charge type.  A face model can score well by recovering those.  So we report\n",
    "  (a) the model's AUC,\n",
    "  (b) AUC of models that never see a face (sex/race/hair/eyes/weight/height only; reference only, not model inputs),\n",
    "  (c) AUC computed *within* Race x Sex strata, which removes the between-group part of the signal.\n",
    "\"\"\"\n",
    "import argparse, glob, re, warnings\n",
    "import numpy as np, pandas as pd\n",
    "from sklearn.ensemble import HistGradientBoostingClassifier\n",
    "from sklearn.metrics import roc_auc_score\n",
    "import labels as L\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "def aucs(Y, P):\n",
    "    return np.array([roc_auc_score(Y[:, k], P[:, k]) if 0 < Y[:, k].sum() < len(Y) else np.nan for k in range(Y.shape[1])])\n",
    "\n",
    "def boot_ci(Y, P, n=300, seed=0):\n",
    "    rng = np.random.default_rng(seed); N = len(Y); out = np.zeros((n, Y.shape[1]))\n",
    "    for b in range(n):\n",
    "        i = rng.integers(0, N, N); out[b] = aucs(Y[i], P[i])\n",
    "    return np.nanpercentile(out, 2.5, 0), np.nanpercentile(out, 97.5, 0)\n",
    "\n",
    "def stratified_auc(Y, P, groups, min_rows=400, min_cls=20):\n",
    "    \"\"\"AUC within each group, averaged (weighted by group size) -> removes between-group (e.g. race/sex) signal.\"\"\"\n",
    "    K = Y.shape[1]; num = np.zeros(K); den = np.zeros(K)\n",
    "    for g in pd.unique(groups):\n",
    "        m = groups == g\n",
    "        if m.sum() < min_rows: continue\n",
    "        for k in range(K):\n",
    "            pos = Y[m, k].sum()\n",
    "            if pos >= min_cls and m.sum() - pos >= min_cls:\n",
    "                num[k] += m.sum() * roc_auc_score(Y[m, k], P[m, k]); den[k] += m.sum()\n",
    "    return np.where(den > 0, num / np.maximum(den, 1), np.nan)\n",
    "\n",
    "def meta(df):\n",
    "    h = df[\"Height\"].str.extract(r\"(\\d+) ft\\. (\\d+) in\").astype(float)\n",
    "    X = pd.DataFrame({\"h\": h[0] * 12 + h[1], \"w\": pd.to_numeric(df[\"Weight\"].str.extract(r\"(\\d+)\")[0], errors=\"coerce\")})\n",
    "    for c in [\"Sex\", \"Race\", \"Hair\", \"Eyes\"]: X[c] = df[c].astype(\"category\").cat.codes\n",
    "    X[\"pre\"] = df[\"ID\"].str[0].astype(\"category\").cat.codes\n",
    "    X[\"num\"] = pd.to_numeric(df[\"ID\"].str[1:], errors=\"coerce\")\n",
    "    return X\n",
    "\n",
    "FEATSETS = {\n",
    "    \"metadata: sex,race,hair,eyes\": [\"Sex\", \"Race\", \"Hair\", \"Eyes\"],\n",
    "    \"metadata: + weight,height\": [\"Sex\", \"Race\", \"Hair\", \"Eyes\", \"w\", \"h\"],\n",
    "}\n",
    "# The ID is an arbitrary key, not something a photo contains, so it is NOT part of the default reference.\n",
    "# Opt in with --id_baseline only as a diagnostic of how much label structure follows ID order.\n",
    "ID_SET = {\"DIAGNOSTIC ONLY (ID is not a legitimate feature): ID prefix/number\": [\"pre\", \"num\"]}\n",
    "\n",
    "def row(name, per, lo=None, hi=None):\n",
    "    d = {\"model\": name, **{n: f\"{v:.3f}\" + (f\" [{l:.3f},{h:.3f}]\" if lo is not None else \"\") for n, v, l, h in\n",
    "        zip(names, per, lo if lo is not None else per, hi if hi is not None else per)}, \"MACRO\": f\"{np.nanmean(per):.3f}\"}\n",
    "    return d\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    ap = argparse.ArgumentParser()\n",
    "    ap.add_argument(\"--csv\", required=True); ap.add_argument(\"--cache_dir\", default=\"./cache\")\n",
    "    ap.add_argument(\"--runs\", nargs=\"+\", required=True); ap.add_argument(\"--seed\", type=int, default=42)\n",
    "    ap.add_argument(\"--boot\", type=int, default=300); ap.add_argument(\"--no_ensemble\", action=\"store_true\"); ap.add_argument(\"--paired\", nargs=2, metavar=(\"RUN_A\", \"RUN_B\"), help=\"paired bootstrap of AUC(B) - AUC(A) on the same test rows\"); ap.add_argument(\"--id_baseline\", action=\"store_true\", help=\"also show the ID-order diagnostic (off by default)\"); ap.add_argument(\"--out\", default=\"report.csv\")\n",
    "    a = ap.parse_args()\n",
    "    paths = sorted({p for r in a.runs for p in glob.glob(r)})\n",
    "    runs = {re.sub(r\"^preds_|\\.npz$\", \"\", p.split(\"/\")[-1]): np.load(p, allow_pickle=True) for p in paths}\n",
    "    first = next(iter(runs.values())); scheme = str(first[\"scheme\"]); names = [str(n) for n in first[\"names\"]]\n",
    "    assert all(str(r[\"scheme\"]) == scheme for r in runs.values()), \"mixing label schemes\"\n",
    "    df = L.load_labels(a.csv); Y, _, _, _ = L.build(df, scheme)\n",
    "    sp = np.load(f\"{a.cache_dir}/split_{scheme}_{a.seed}.npz\"); tr, te = sp[\"train\"], sp[\"test\"]\n",
    "    for r in runs.values(): assert (r[\"test_idx\"] == te).all(), \"runs were evaluated on different test rows\"\n",
    "    Yt = Y[te]\n",
    "    cand = {k: v[\"test_pred\"] for k, v in runs.items()}\n",
    "    if len(runs) > 1 and not a.no_ensemble:\n",
    "        cand[\"ENSEMBLE(mean prob)\"] = np.mean([v[\"test_pred\"] for v in runs.values()], 0)\n",
    "\n",
    "    rows, strat = [], []\n",
    "    grp = (df[\"Race\"].fillna(\"NA\") + \"|\" + df[\"Sex\"].fillna(\"NA\")).values[te]\n",
    "    for n, P in cand.items():\n",
    "        lo, hi = boot_ci(Yt, P, a.boot)\n",
    "        rows.append(row(n, aucs(Yt, P), lo, hi)); strat.append(row(n + \"  [within race x sex]\", stratified_auc(Yt, P, grp)))\n",
    "    X = meta(df); base_rows, base_strat = [], []\n",
    "    for n, cols in (dict(FEATSETS, **ID_SET) if a.id_baseline else FEATSETS).items():\n",
    "        P = np.zeros((len(te), Y.shape[1]))\n",
    "        for k in range(Y.shape[1]):\n",
    "            m = HistGradientBoostingClassifier(max_iter=150, learning_rate=0.06, max_leaf_nodes=15, l2_regularization=1.0, random_state=0)\n",
    "            m.fit(X.iloc[tr][cols].values, Y[tr, k]); P[:, k] = m.predict_proba(X.iloc[te][cols].values)[:, 1]\n",
    "        base_rows.append(row(n, aucs(Yt, P))); base_strat.append(row(n + \"  [within race x sex]\", stratified_auc(Yt, P, grp)))\n",
    "\n",
    "    if a.paired:\n",
    "        A, B = a.paired; rng = np.random.default_rng(0); d = []\n",
    "        for _ in range(a.boot):\n",
    "            i = rng.integers(0, len(Yt), len(Yt)); d.append(aucs(Yt[i], cand[B][i]) - aucs(Yt[i], cand[A][i]))\n",
    "        d = np.array(d); pt = aucs(Yt, cand[B]) - aucs(Yt, cand[A]); lo, hi = np.nanpercentile(d, 2.5, 0), np.nanpercentile(d, 97.5, 0)\n",
    "        m = np.nanmean(d, 1); prow = {\"AUC(%s) - AUC(%s)\" % (B, A): \"paired diff [95% CI]\", **{n: f\"{p:+.3f} [{l:+.3f},{h:+.3f}]\" for n, p, l, h in zip(names, pt, lo, hi)},\n",
    "                                       \"MACRO\": f\"{np.nanmean(pt):+.3f} [{np.percentile(m,2.5):+.3f},{np.percentile(m,97.5):+.3f}]\"}\n",
    "        print(\"\\n=== PAIRED COMPARISON (same test rows; CI excludes 0 => real difference) ===\"); print(pd.DataFrame([prow]).set_index(list(prow)[0]).to_string())\n",
    "    pd.set_option(\"display.width\", 250); pd.set_option(\"display.max_columns\", 30)\n",
    "    print(f\"\\nscheme={scheme}  test rows={len(te)}  (positives per category: {dict(zip(names, Yt.sum(0).astype(int)))})\")\n",
    "    print(\"\\n=== FACE MODELS: test AUC per category [95% bootstrap CI] ===\")\n",
    "    print(pd.DataFrame(rows).set_index(\"model\").to_string())\n",
    "    print(\"\\n=== REFERENCE: models that never see a face (tabular metadata; NOT inputs to the image model) ===\")\n",
    "    print(pd.DataFrame(base_rows).set_index(\"model\").to_string())\n",
    "    print(\"\\n=== SAME COMPARISON WITH RACE x SEX HELD FIXED (AUC averaged within strata) ===\")\n",
    "    print(pd.DataFrame(strat + base_strat).set_index(\"model\").to_string())\n",
    "    pd.DataFrame(rows + base_rows + strat + base_strat).to_csv(a.out, index=False); print(\"\\nsaved\", a.out)"
