    "        f\"global_bs={a.batch_size*world} steps/epoch={len(ld_tr)}\")\n",
    "\n",
    "    total = a.epochs * len(ld_tr); warm = int(a.warmup_epochs * len(ld_tr)); step = 0\n",
    "    best, bad, ckpt = -1.0, 0, out / f\"{run}_best.pt\"\n",
    "    eval_model = (ema.module if ema else net)\n",
    "    for ep in range(a.epochs):\n",
    "        ld_tr.set_epoch(ep); model.train(); t0 = time.time(); wait = 0.0; seen = 0\n",
    "        lsum = torch.zeros((), device=dev); nb = 0; it = iter(ld_tr)\n",
    "        while True:\n",
    "            tw = time.time()\n",
    "            try: xb, yb, _ = next(it)\n",
    "            except StopIteration: break\n",
    "            wait += time.time() - tw\n",
    "            x = gpu_augment(to_float(xb, dev), a); y = yb.to(dev, non_blocking=True)\n",
    "            if a.mixup > 0:\n",
    "                lam = float(np.random.beta(a.mixup, a.mixup)); perm = torch.randperm(x.shape[0], device=dev)\n",
    "                x = lam * x + (1 - lam) * x[perm]; y = lam * y + (1 - lam) * y[perm]\n",
    "            sc = lr_scale(step, total, warm)\n",
    "            for g in opt.param_groups: g[\"lr\"] = g[\"base_lr\"] * sc\n",
    "            with torch.autocast(\"cuda\", dtype=torch.float16, enabled=dev.type == \"cuda\"):\n",
    "                lg = model(x)\n",
    "            loss = loss_fn(lg.float(), y)\n",
    "            opt.zero_grad(set_to_none=True)\n",
    "            scaler.scale(loss).backward(); scaler.unscale_(opt)\n",
    "            nn.utils.clip_grad_norm_(net.parameters(), 1.0)\n",
    "            scaler.step(opt); scaler.update()\n",
    "            if ema: ema.update(step)\n",
    "            step += 1; lsum += loss.detach(); nb += 1; seen += x.shape[0] * world\n",
    "        if dev.type == \"cuda\": torch.cuda.synchronize()\n",
    "        dt = time.time() - t0\n",
    "        vi, vp, _ = predict(eval_model, ld_va, dev, world, tta=False)\n",
    "        vauc, vper = macro_auc(Y[vi], vp)\n",
    "        log(f\"[{ep+1}/{a.epochs}] loss={lsum.item()/max(nb,1):.4f} val_macroAUC={vauc:.4f} | {dt:.0f}s ({seen/dt:.0f} img/s) \"\n",
    "            f\"data-wait={100*wait/dt:.0f}% {'<- CPU/loader-bound' if wait/dt > 0.2 else ''}\")\n",
    "        if vauc > best:\n",
    "            best, bad = vauc, 0\n",
    "            if rank == 0: torch.save(eval_model.state_dict(), ckpt)\n",
    "            log(\"   val per-cat: \" + \" \".join(f\"{n[:6]}={v:.3f}\" for n, v in zip(names, vper)) + \"  (new best, saved)\")\n",
    "        else:\n",
    "            bad += 1\n",
    "            if a.patience and bad >= a.patience: log(\"early stop\"); break\n",
    "    if world > 1: dist.barrier()\n",
    "\n",
    "    # ---- final: best-val weights, TTA, test report\n",
    "    eval_model.load_state_dict(torch.load(ckpt, map_location=dev)); \n",
    "    vi, _, vp = predict(eval_model, ld_va, dev, world, tta=True)\n",
    "    ti, tp0, tp = predict(eval_model, ld_te, dev, world, tta=True)\n",
    "    t_no, _ = macro_auc(Y[ti], tp0); t_tta, per = macro_auc(Y[ti], tp); v_tta, _ = macro_auc(Y[vi], vp)\n",
    "    log(f\"FINAL {run}: best val={best:.4f} | val(TTA)={v_tta:.4f} | TEST macroAUC no-TTA={t_no:.4f} TTA={t_tta:.4f}\")\n",
    "    log(\"TEST per-category: \" + \" \".join(f\"{n}={v:.3f}\" for n, v in zip(names, per)))\n",
    "    if rank == 0:\n",
    "        np.savez(out / f\"preds_{run}.npz\", val_idx=vi, val_pred=vp, test_idx=ti, test_pred=tp, names=np.array(names), scheme=a.scheme)\n",
    "    if world > 1: dist.destroy_process_group()\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
