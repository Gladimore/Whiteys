    "# =============================================================== numpy / cv2 helpers (unit-testable without torch)\n",
    "def aucs(Y, P):\n",
    "    from sklearn.metrics import roc_auc_score\n",
    "    return np.array([roc_auc_score(Y[:, k], P[:, k]) if 0 < Y[:, k].sum() < len(Y) else np.nan for k in range(Y.shape[1])])\n",
    "\n",
    "def delta_ci(Y, Pa, Pb, n=100, seed=0):\n",
    "    \"\"\"paired bootstrap of macro-AUC(Pb) - macro-AUC(Pa)\"\"\"\n",
    "    rng = np.random.default_rng(seed); N = len(Y); d = []\n",
    "    for _ in range(n):\n",
    "        i = rng.integers(0, N, N); d.append(np.nanmean(aucs(Y[i], Pb[i])) - np.nanmean(aucs(Y[i], Pa[i])))\n",
    "    return float(np.mean(d)), float(np.percentile(d, 2.5)), float(np.percentile(d, 97.5))\n",
    "\n",
    "def detect_faces(imgs, scales=(1.0, 0.75, 1.33)):\n",
    "    \"\"\"Largest Haar frontal face per RGB uint8 image -> boxes (x,y,w,h) in image coords + found mask.\n",
    "    The cache is squashed to a square, so also try compressed/stretched widths.\"\"\"\n",
    "    casc = cv2.CascadeClassifier(cv2.data.haarcascades + \"haarcascade_frontalface_default.xml\")\n",
    "    N, H, W = imgs.shape[:3]; boxes = np.zeros((N, 4), np.float32); found = np.zeros(N, bool)\n",
    "    for n in range(N):\n",
    "        g = cv2.cvtColor(imgs[n], cv2.COLOR_RGB2GRAY)\n",
    "        for s in scales:\n",
    "            gg = g if s == 1.0 else cv2.resize(g, (max(8, int(W * s)), H))\n",
    "            det = casc.detectMultiScale(gg, 1.1, 5, minSize=(int(0.18 * H), int(0.18 * H)))\n",
    "            if len(det):\n",
    "                x, y, w, h = max(det, key=lambda d: d[2] * d[3])\n",
    "                boxes[n] = (x / s, y, w / s, h); found[n] = True; break\n",
    "    return boxes, found\n",
    "\n",
    "def expand(boxes, fx=1.0, fy=1.0, dy=0.0, H=224, W=224):\n",
    "    \"\"\"scale a box about its centre (and shift it up by dy*height); returns clipped (x0,y0,x1,y1)\"\"\"\n",
    "    x, y, w, h = boxes.T; cx, cy = x + w / 2, y + h / 2 - dy * h\n",
    "    x0, x1 = cx - w * fx / 2, cx + w * fx / 2; y0, y1 = cy - h * fy / 2, cy + h * fy / 2\n",
    "    return np.stack([np.clip(x0, 0, W), np.clip(y0, 0, H), np.clip(x1, 0, W), np.clip(y1, 0, H)], 1)\n",
    "\n",
    "def box_masks(xyxy, H=224, W=224):\n",
    "    xs = np.arange(W)[None, None, :]; ys = np.arange(H)[None, :, None]\n",
    "    x0, y0, x1, y1 = [xyxy[:, i][:, None, None] for i in range(4)]\n",
    "    return (xs >= x0) & (xs < x1) & (ys >= y0) & (ys < y1)\n",
    "\n",
    "def face_box(b, H=224, W=224): return expand(b, 1.0, 1.0, 0.0, H, W)\n",
    "def head_box(b, H=224, W=224): return expand(b, 1.7, 1.9, 0.15, H, W)       # hair, ears, neck margin\n",
    "\n",
    "def fixed_masks(n, H=224, W=224, inner=(0.2, 0.8)):\n",
    "    m = np.zeros((H, W), bool); m[int(inner[0] * H):int(inner[1] * H), int(inner[0] * W):int(inner[1] * W)] = True\n",
    "    return np.broadcast_to(m, (n, H, W))\n",
    "\n",
    "def keep(x, m):\n",
    "    out = np.full_like(x, GRAY); out[m] = x[m]; return out\n",
    "def blank(x, m):\n",
    "    out = x.copy(); out[m] = GRAY; return out\n",
    "\n",
    "def patch_shuffle(x, p=16, seed=0):\n",
    "    B, H, W, C = x.shape; gh, gw = H // p, W // p; rng = np.random.default_rng(seed); out = np.empty_like(x)\n",
    "    for b in range(B):\n",
    "        t = x[b].reshape(gh, p, gw, p, C).transpose(0, 2, 1, 3, 4).reshape(gh * gw, p, p, C)[rng.permutation(gh * gw)]\n",
    "        out[b] = t.reshape(gh, gw, p, p, C).transpose(0, 2, 1, 3, 4).reshape(H, W, C)\n",
    "    return out\n",
    "\n",
    "def make_conds(use_alpha=False):\n",
    "    \"\"\"name -> f(batch_uint8[B,H,W,3], face_boxes[B,4]) -> batch_uint8.  Interpret in PAIRS (sufficient vs necessary).\"\"\"\n",
    "    H = W = 224\n",
    "    conds = {\n",
    "        \"full image (reference)\":              lambda x, b, m: x,\n",
    "        \"FACE ONLY (rest grey)\":               lambda x, b, m: keep(x, box_masks(face_box(b), H, W)),\n",
    "        \"HEAD ONLY (face+hair, rest grey)\":    lambda x, b, m: keep(x, box_masks(head_box(b), H, W)),\n",
    "        \"FACE BLANKED (rest visible)\":         lambda x, b, m: blank(x, box_masks(face_box(b), H, W)),\n",
    "        \"HEAD BLANKED (background+body only)\": lambda x, b, m: blank(x, box_masks(head_box(b), H, W)),\n",
    "        \"centre 60% only\":                     lambda x, b, m: keep(x, fixed_masks(len(x), H, W, (0.2, 0.8))),\n",
    "        \"outer 20% frame only\":                lambda x, b, m: blank(x, fixed_masks(len(x), H, W, (0.2, 0.8))),\n",
    "        \"grayscale (no colour)\":               lambda x, b, m: np.stack([np.repeat(cv2.cvtColor(i, cv2.COLOR_RGB2GRAY)[..., None], 3, 2) for i in x]),\n",
    "        \"blurred (sigma 3, no fine texture)\":  lambda x, b, m: np.stack([cv2.GaussianBlur(i, (0, 0), 3) for i in x]),\n",
    "        \"low-res 48px (coarse shape only)\":    lambda x, b, m: np.stack([cv2.resize(cv2.resize(i, (48, 48), interpolation=cv2.INTER_AREA), (W, H), interpolation=cv2.INTER_LINEAR) for i in x]),\n",
    "        \"patches shuffled (no layout)\":        lambda x, b, m: patch_shuffle(x, 16, 0),\n",
    "        \"upside down\":                         lambda x, b, m: x[:, ::-1].copy(),\n",
    "    }\n",
    "    if use_alpha:                                              # person-alpha maps from remove_bg.py (uint8, 255 = person)\n",
    "        import remove_bg as R\n",
    "        conds[\"BG: BACKGROUND REMOVED (person only)\"] = lambda x, b, m: R.composite(x, m)\n",
    "        conds[\"BG: BACKGROUND ONLY (person greyed out)\"] = lambda x, b, m: R.composite_bg_only(x, m)\n",
    "    return conds\n",
    "\n",
    "def pool_mask(mask, g):\n",
    "    n, H, W = mask.shape\n",
    "    return mask.reshape(n, g, H // g, g, W // g).mean((2, 4))\n",
    "\n",
    "def attribution_shares(cam, face, head, border):\n",
    "    \"\"\"cam [N,g,g] >=0 ; masks [N,H,W] bool -> {region: (share of attribution, area fraction, enrichment)}\"\"\"\n",
    "    g = cam.shape[1]; c = cam / (cam.sum((1, 2), keepdims=True) + 1e-9); out = {}\n",
    "    for name, m in [(\"face box\", face), (\"head box\", head), (\"outside head box\", ~head), (\"outer 10% border\", border)]:\n",
    "        cov = pool_mask(m.astype(np.float32), g); sh, ar = float((c * cov).sum((1, 2)).mean()), float(cov.mean())\n",
    "        out[name] = (sh, ar, sh / max(ar, 1e-9))\n",
    "    return out\n",
    "\n",
    "# =============================================================== torch parts\n",
    "def to_t(x_u8, dev):\n",
    "    import torch\n",
    "    return torch.from_numpy(np.ascontiguousarray(x_u8)).to(dev).permute(0, 3, 1, 2).float().div_(255)\n",
    "\n",
    "def load_model(a, K, dev):\n",
    "    import torch\n",
    "    from train import Net\n",
    "    net = Net(a.backbone, K, 0.0, 0.0, a.img_size, np.full(K, 0.2), pretrained=False)\n",
    "    net.load_state_dict(torch.load(a.ckpt, map_location=\"cpu\"))\n",
    "    net.to(dev).eval()\n",
    "    for p in net.parameters(): p.requires_grad_(False)\n",
    "    return net\n",
    "\n",
    "def forward_probs(net, fn, N, dev, bs=100):\n",
    "    import torch\n",
    "    out = []\n",
    "    with torch.no_grad(), torch.autocast(\"cuda\", dtype=torch.float16, enabled=dev.type == \"cuda\"):\n",
    "        for i in range(0, N, bs):\n",
    "            out.append(torch.sigmoid(net(to_t(fn(i, min(N, i + bs)), dev)).float()).cpu().numpy())\n",
    "    return np.concatenate(out)\n",
    "\n",
    "def grad_cam(net, imgs, K, dev, bs=32, layer=-1):\n",
    "    \"\"\"Grad-CAM on the INPUT of the last block's attention (norm1 output).  (The last block's own output is useless\n",
    "    here: only the CLS token is read after it, so patch tokens get zero gradient.)  Returns cams [N,K,g,g], logits [N,K].\"\"\"\n",
    "    import torch\n",
    "    blk, store = net.backbone.blocks[layer], {}\n",
    "    npre = getattr(net.backbone, \"num_prefix_tokens\", 1)\n",
    "    def hook(m, i, o):\n",
    "        o2 = o.detach().requires_grad_(True); store[\"a\"] = o2; return o2     # fresh leaf: autograd only walks the last block + head\n",
    "    h = blk.norm1.register_forward_hook(hook)\n",
    "    N = len(imgs); cams = None; logits = np.zeros((N, K), np.float32)\n",
    "    for i in range(0, N, bs):\n",
    "        x = to_t(imgs[i:i + bs], dev)\n",
    "        with torch.enable_grad():\n",
    "            lg = net(x); act = store[\"a\"]; B = act.shape[0]; g = int(round((act.shape[1] - npre) ** 0.5))\n",
    "            if cams is None: cams = np.zeros((N, K, g, g), np.float32)\n",
    "            for k in range(K):\n",
    "                grad, = torch.autograd.grad(lg[:, k].sum(), act, retain_graph=k < K - 1)\n",
    "                w = grad[:, npre:, :].mean(1, keepdim=True)\n",
    "                cams[i:i + B, k] = torch.relu((act[:, npre:, :] * w).sum(-1)).reshape(B, g, g).detach().cpu().numpy()\n",
    "        logits[i:i + B] = lg.detach().cpu().numpy()\n",
    "    h.remove()\n",
    "    return cams, logits\n",
    "\n",
    "def occlusion_map(net, img, k, dev, win=48, stride=16, bs=72):\n",
    "    \"\"\"drop in the category-k logit when a grey window is placed at each position (positive = region SUPPORTS category)\"\"\"\n",
    "    import torch\n",
    "    x = to_t(img[None], dev); H, W = x.shape[2:]; pos = [(i, j) for i in range(0, H - win + 1, stride) for j in range(0, W - win + 1, stride)]\n",
    "    drops = []\n",
    "    with torch.no_grad(), torch.autocast(\"cuda\", dtype=torch.float16, enabled=dev.type == \"cuda\"):\n",
    "        base = net(x).float()[0, k]\n",
    "        for s in range(0, len(pos), bs):\n",
    "            xs = x.repeat(len(pos[s:s + bs]), 1, 1, 1)\n",
    "            for n, (i, j) in enumerate(pos[s:s + bs]): xs[n, :, i:i + win, j:j + win] = 0.5\n",
    "            drops.append((base - net(xs).float()[:, k]).cpu().numpy())\n",
    "    drops = np.concatenate(drops); heat = np.zeros((H, W), np.float32); cnt = np.zeros((H, W), np.float32)\n",
    "    for d, (i, j) in zip(drops, pos): heat[i:i + win, j:j + win] += d; cnt[i:i + win, j:j + win] += 1\n",
    "    return heat / np.maximum(cnt, 1)\n",
    "\n",
    "def embed(net, imgs, dev, bs=100):\n",
    "    import torch\n",
    "    out = []\n",
    "    with torch.no_grad(), torch.autocast(\"cuda\", dtype=torch.float16, enabled=dev.type == \"cuda\"):\n",
    "        for i in range(0, len(imgs), bs):\n",
    "            x = to_t(imgs[i:i + bs], dev); out.append(net.backbone((x - net.mean) / net.std).float().cpu().numpy())\n",
    "    return np.concatenate(out)\n",
    "\n",
    "# =============================================================== plots\n",
    "def plt_():\n",
    "    import matplotlib; matplotlib.use(\"Agg\"); import matplotlib.pyplot as plt; return plt\n",
    "\n",
    "def save_detections(imgs, boxes, found, path, n=16):\n",
    "    plt = plt_(); idx = np.flatnonzero(found)[:n // 2].tolist() + np.flatnonzero(~found)[:n // 2].tolist()\n",
    "    fig, axs = plt.subplots(2, 8, figsize=(20, 5.6))\n",
    "    for ax, i in zip(axs.ravel(), idx):\n",
    "        ax.imshow(imgs[i]); ax.axis(\"off\")\n",
    "        if found[i]:\n",
    "            x, y, w, h = boxes[i]; ax.add_patch(plt.Rectangle((x, y), w, h, fill=False, ec=\"lime\", lw=2))\n",
    "            hx0, hy0, hx1, hy1 = head_box(boxes[i:i + 1], *imgs.shape[1:3])[0]; ax.add_patch(plt.Rectangle((hx0, hy0), hx1 - hx0, hy1 - hy0, fill=False, ec=\"yellow\", lw=1.5, ls=\"--\"))\n",
    "        ax.set_title(\"detected\" if found[i] else \"NOT detected\", fontsize=8)\n",
    "    fig.suptitle(\"Face detections (green = face box, yellow = head box). Check these before trusting the face-box numbers.\"); fig.tight_layout(); fig.savefig(path, dpi=100); plt.close(fig)\n",
    "\n",
    "def save_mean_maps(imgs, cams, probs, names, boxes, found, path, top=300):\n",
    "    plt = plt_(); K = cams.shape[1]; H, W = imgs.shape[1:3]; fig, axs = plt.subplots(2, K + 1, figsize=(2.6 * (K + 1), 5.6))\n",
    "    mb = np.median(boxes[found], 0) if found.any() else None\n",
    "    def panel(ax, base, heat, title):\n",
    "        ax.imshow(base.astype(np.uint8)); \n",
    "        if heat is not None: ax.imshow(cv2.resize(heat, (W, H), interpolation=cv2.INTER_CUBIC), cmap=\"jet\", alpha=0.5)\n",
    "        if mb is not None: ax.add_patch(plt.Rectangle((mb[0], mb[1]), mb[2], mb[3], fill=False, ec=\"white\", lw=1.2, ls=\"--\"))\n",
    "        ax.set_title(title, fontsize=8); ax.axis(\"off\")\n",
    "    allm = imgs.mean(0); panel(axs[0, 0], allm, None, \"mean image\\n(dashed = median face box)\")\n",
    "    c_all = (cams / (cams.sum((2, 3), keepdims=True) + 1e-9))\n",
    "    panel(axs[1, 0], allm, c_all.mean((0, 1)), \"mean Grad-CAM,\\nall images, all categories\")\n",
    "    for k in range(K):\n",
    "        top_i = np.argsort(-probs[:, k])[:top]; bm = imgs[top_i].mean(0)\n",
    "        panel(axs[0, k + 1], bm, None, f\"{names[k]}\\nmean of top-{top} scored\"); panel(axs[1, k + 1], bm, c_all[top_i, k].mean(0), \"mean Grad-CAM\")\n",
    "    fig.tight_layout(); fig.savefig(path, dpi=100); plt.close(fig)\n",
    "\n",
    "def save_gallery(net, imgs, cams, probs, Y, k, name, dev, path, n_each=3):\n",
    "    plt = plt_(); H, W = imgs.shape[1:3]; hits = np.flatnonzero(Y[:, k] == 1); fas = np.flatnonzero(Y[:, k] == 0)\n",
    "    rows = [(i, \"TRUE POS\") for i in hits[np.argsort(-probs[hits, k])][:n_each]] + [(i, \"FALSE ALARM\") for i in fas[np.argsort(-probs[fas, k])][:n_each]]\n",
    "    fig, axs = plt.subplots(len(rows), 3, figsize=(8.4, 2.8 * len(rows)))\n",
    "    for r, (i, tag) in enumerate(rows):\n",
    "        occ = occlusion_map(net, imgs[i], k, dev); cam = cv2.resize(cams[i, k] / (cams[i, k].max() + 1e-9), (W, H), interpolation=cv2.INTER_CUBIC)\n",
    "        axs[r, 0].imshow(imgs[i]); axs[r, 0].set_title(f\"{tag}  p={probs[i, k]:.2f}\", fontsize=8)\n",
    "        axs[r, 1].imshow(imgs[i]); axs[r, 1].imshow(cam, cmap=\"jet\", alpha=0.5, vmin=0, vmax=1); axs[r, 1].set_title(\"Grad-CAM\", fontsize=8)\n",
    "        m = np.abs(occ).max() + 1e-9; axs[r, 2].imshow(imgs[i]); axs[r, 2].imshow(occ, cmap=\"bwr\", alpha=0.55, vmin=-m, vmax=m); axs[r, 2].set_title(\"occlusion (red = supports)\", fontsize=8)\n",
    "        for c in range(3): axs[r, c].axis(\"off\")\n",
    "    fig.suptitle(f\"{name}\", fontsize=11); fig.tight_layout(); fig.savefig(path, dpi=100); plt.close(fig)\n",
    "\n",
    "# =============================================================== main\n",
    "def main():\n",
    "    import pandas as pd\n",
    "    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n",
    "    ap.add_argument(\"--csv\", required=True, help=\"labels_utf8.csv\")\n",
    "    ap.add_argument(\"--img_cache\", required=True, help=\"directory containing imgs_<tag>.npy, ids_<tag>.npy, ok_<tag>.npy\")\n",
    "    ap.add_argument(\"--cache_tag\", default=\"224\")\n",
    "    ap.add_argument(\"--split\", required=True, help=\"split_<scheme>_<seed>.npz written by train.py\")\n",
    "    ap.add_argument(\"--ckpt\", required=True, help=\"<run>_best.pt written by train.py\")\n",
    "    ap.add_argument(\"--backbone\", default=\"vit_base_patch16_clip_224.openai\"); ap.add_argument(\"--img_size\", type=int, default=224)\n",
    "    ap.add_argument(\"--scheme\", default=\"v2\", choices=list(L.SCHEMES)); ap.add_argument(\"--out\", default=\"./explain\")\n",
    "    ap.add_argument(\"--n\", type=int, default=3000, help=\"test images to analyse\"); ap.add_argument(\"--seed\", type=int, default=0)\n",
    "    ap.add_argument(\"--steps\", default=\"detect,cam,gallery,ablate,probe,sanity\")\n",
    "    ap.add_argument(\"--alpha\", default=None, help=\"alpha_<tag>.npy from remove_bg.py: adds BACKGROUND REMOVED / BACKGROUND ONLY conditions\")\n",
    "    a = ap.parse_args(); steps = set(a.steps.split(\",\")); out = Path(a.out); out.mkdir(parents=True, exist_ok=True)\n",
    "    import torch\n",
    "    dev = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\"); t0 = time.time()\n",
    "    def log(*x): print(f\"[{time.time()-t0:5.0f}s]\", *x, flush=True)\n",
    "\n",
    "    # ---- data: a random subset of the TEST split\n",
    "    df = L.load_labels(a.csv); Y, _, _, _ = L.build(df, a.scheme); names = L.SCHEMES[a.scheme][0]; K = len(names)\n",
    "    img = Path(a.img_cache); ids = np.load(img / f\"ids_{a.cache_tag}.npy\"); ok = np.load(img / f\"ok_{a.cache_tag}.npy\")\n",
    "    assert len(ids) == len(df) and (ids == df[\"ID\"].values.astype(str)).all(), \"cache rows do not match this labels CSV\"\n",
    "    mm = np.load(img / f\"imgs_{a.cache_tag}.npy\", mmap_mode=\"r\"); sp = np.load(a.split); te, tr = sp[\"test\"], sp[\"train\"]\n",
    "    pool = te[ok[te]]; sub = np.sort(np.random.default_rng(a.seed).choice(pool, size=min(a.n, len(pool)), replace=False))\n",
    "    imgs = np.ascontiguousarray(mm[sub]); Ys = Y[sub]; N = len(imgs)\n",
    "    net = load_model(a, K, dev); log(f\"{N} test images, model loaded from {a.ckpt}\")\n",
    "\n",
    "    P = forward_probs(net, lambda i, j: imgs[i:j], N, dev)\n",
    "    base = aucs(Ys, P); log(f\"SANITY: macro AUC on this subset = {np.nanmean(base):.3f}  (should be close to the test AUC you saw, ~0.737 for CLIP/v2)\")\n",
    "    print(\"   per-category:\", dict(zip(names, base.round(3))))\n",
    "\n",
    "    boxes, found = (np.zeros((N, 4), np.float32), np.zeros(N, bool))\n",
    "    if steps & {\"detect\", \"cam\", \"ablate\"}:\n",
    "        boxes, found = detect_faces(imgs); log(f\"face detected in {found.mean()*100:.0f}% of images\")\n",
    "        save_detections(imgs, boxes, found, out / \"detections.png\")\n",
    "        if found.mean() < 0.5: log(\"WARNING: low detection rate; face-box results below describe only the detected subset and may be biased\")\n",
    "\n",
    "    cams = probs = None\n",
    "    if steps & {\"cam\", \"gallery\", \"sanity\"}:\n",
    "        cams, logits = grad_cam(net, imgs, K, dev); probs = 1 / (1 + np.exp(-logits)); np.savez_compressed(out / \"gradcam.npz\", cams=cams, sub=sub)\n",
    "        log(\"Grad-CAM done\")\n",
    "    if \"cam\" in steps:\n",
    "        save_mean_maps(imgs, cams, probs, names, boxes, found, out / \"mean_maps.png\")\n",
    "        f = found; rows = []\n",
    "        for k in range(K):\n",
    "            sh = attribution_shares(cams[f, k], box_masks(face_box(boxes[f])), box_masks(head_box(boxes[f])), ~fixed_masks(int(f.sum()), 224, 224, (0.1, 0.9)))\n",
    "            for reg, (s, ar, en) in sh.items(): rows.append(dict(category=names[k], region=reg, share_of_attribution=round(s, 3), area_fraction=round(ar, 3), enrichment=round(en, 2)))\n",
    "        tab = pd.DataFrame(rows); tab.to_csv(out / \"cam_enrichment.csv\", index=False)\n",
    "        print(\"\\n=== Grad-CAM attribution by region (enrichment 1.0 = proportional to area; >1 = model uses it MORE than its size) ===\")\n",
    "        print(tab.pivot(index=\"category\", columns=\"region\", values=\"enrichment\").loc[names].to_string())\n",
    "        print(\"\\n=== share of Grad-CAM mass ===\")\n",
    "        print(tab.pivot(index=\"category\", columns=\"region\", values=\"share_of_attribution\").loc[names].to_string())\n",
    "    if \"gallery\" in steps:\n",
    "        for k in range(K):\n",
